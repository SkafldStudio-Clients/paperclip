# =============================================================================
# Paperclip — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in values for your deployment.
# Variables marked REQUIRED have no default and will cause startup failures
# if omitted. Variables marked OPTIONAL have sane defaults noted inline.
# Sections that are cloud/provider-specific (AWS, S3, SSH) are only needed
# when that integration is enabled.
# =============================================================================


# -----------------------------------------------------------------------------
# Core — Required for all deployments
# -----------------------------------------------------------------------------

DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
# REQUIRED: PostgreSQL connection string for the main database.

PORT=3100
# Port the HTTP server listens on.

SERVE_UI=false
# Set to true to serve the compiled UI bundle from the server.

BETTER_AUTH_SECRET=paperclip-dev-secret
# REQUIRED: Secret key used to sign better-auth sessions. Use a long random string in production.

# DATABASE_MIGRATION_URL=
# Separate connection string for running migrations (e.g. a superuser URL).
# Falls back to DATABASE_URL if omitted.


# -----------------------------------------------------------------------------
# Authentication (better-auth)
# -----------------------------------------------------------------------------

# BETTER_AUTH_URL=http://localhost:3100
# Base URL used by better-auth for generating links (password reset, etc.).
# Required in non-local deployments.

# BETTER_AUTH_BASE_URL=http://localhost:3100
# Alternative base URL override for better-auth internals.

# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100,https://your-domain.com
# Comma-separated list of origins trusted for CORS and CSRF.

# PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://your-domain.com
# Public-facing base URL used when constructing auth callback URLs.

# PAPERCLIP_AUTH_BASE_URL_MODE=auto
# Controls how the auth base URL is derived. Values: auto | explicit.

# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# Set to true to prevent new user registrations.

# PAPERCLIP_ALLOWED_HOSTNAMES=localhost,your-domain.com
# Comma-separated list of hostnames allowed to make API requests.


# -----------------------------------------------------------------------------
# Agent JWT authentication
# -----------------------------------------------------------------------------

# PAPERCLIP_AGENT_JWT_SECRET=
# REQUIRED when agent JWT auth is enabled: secret used to sign agent tokens.

# PAPERCLIP_AGENT_JWT_ISSUER=paperclip
# JWT issuer claim for agent tokens.

# PAPERCLIP_AGENT_JWT_AUDIENCE=paperclip-agents
# JWT audience claim for agent tokens.

# PAPERCLIP_AGENT_JWT_TTL_SECONDS=3600
# TTL (seconds) for issued agent JWTs. Default: 3600 (1 hour).


# -----------------------------------------------------------------------------
# Server / Network binding
# -----------------------------------------------------------------------------

# HOST=0.0.0.0
# Hostname to bind the server to.

# PAPERCLIP_PUBLIC_URL=http://localhost:3100
# Externally reachable URL of this instance. Used in webhook callbacks, invites, etc.

# PAPERCLIP_BIND=0.0.0.0:3100
# Combined host:port bind string (alternative to HOST + PORT).

# PAPERCLIP_BIND_HOST=0.0.0.0
# Host portion of the bind address.

# PAPERCLIP_LISTEN_HOST=0.0.0.0
# Explicit listen host (overrides PAPERCLIP_BIND_HOST).

# PAPERCLIP_LISTEN_PORT=3100
# Explicit listen port (overrides PORT).

# PAPERCLIP_TAILNET_BIND_HOST=
# Tailscale/tailnet hostname to bind on (for mesh networking deployments).

# PAPERCLIP_OPEN_ON_LISTEN=false
# Set to true to open the browser automatically after startup.

# PAPERCLIP_UI_DEV_MIDDLEWARE=false
# Set to true to proxy UI requests to the Vite dev server (dev only).


# -----------------------------------------------------------------------------
# Deployment / instance config
# -----------------------------------------------------------------------------

# PAPERCLIP_DEPLOYMENT_MODE=self-hosted
# Deployment mode. Values: self-hosted | cloud | embedded.

# PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# Exposure level. Values: private | public.

# PAPERCLIP_HOME=~/.paperclip
# Directory for Paperclip instance data (DB, secrets, storage).

# PAPERCLIP_INSTANCE_ROOT=
# Root directory for this instance (overrides PAPERCLIP_HOME).

# PAPERCLIP_INSTANCE_ID=
# Unique identifier for this instance. Auto-generated if omitted.

# PAPERCLIP_CONFIG=
# Path to a JSON config file. Env vars take precedence over file values.

# PAPERCLIP_MIGRATION_AUTO_APPLY=false
# Automatically apply pending DB migrations on startup.

# PAPERCLIP_MIGRATION_PROMPT=true
# Prompt before applying migrations (only when running interactively).

# PAPERCLIP_ENABLE_COMPANY_DELETION=false
# Allow companies to be permanently deleted via the API.

# PAPERCLIP_API_BRIDGE_MODE=
# Internal: API bridge operating mode for cloud-connected instances.


# -----------------------------------------------------------------------------
# Heartbeat scheduler
# -----------------------------------------------------------------------------

HEARTBEAT_SCHEDULER_ENABLED=true
# Enable the background heartbeat scheduler that drives agent wakeups.

# HEARTBEAT_SCHEDULER_INTERVAL_MS=30000
# Interval between heartbeat scheduler ticks. Default: 30000ms.


# -----------------------------------------------------------------------------
# Secrets provider
# -----------------------------------------------------------------------------

# PAPERCLIP_SECRETS_PROVIDER=local_encrypted
# Secrets backend. Values: local_encrypted | aws_secrets_manager.

# PAPERCLIP_SECRETS_MASTER_KEY=
# Raw master key (base64). Use instead of PAPERCLIP_SECRETS_MASTER_KEY_FILE.

# PAPERCLIP_SECRETS_MASTER_KEY_FILE=
# Path to a file containing the master encryption key.

# PAPERCLIP_SECRETS_STRICT_MODE=false
# Fail hard if any secret cannot be decrypted (vs. returning null).


# -----------------------------------------------------------------------------
# Secrets provider — AWS Secrets Manager
# Only required when PAPERCLIP_SECRETS_PROVIDER=aws_secrets_manager
# -----------------------------------------------------------------------------

# PAPERCLIP_SECRETS_AWS_PROVIDER_OWNER=
# Owning account/org identifier used to namespace secrets.

# PAPERCLIP_SECRETS_AWS_REGION=us-east-1
# AWS region for Secrets Manager operations.

# PAPERCLIP_SECRETS_AWS_ENVIRONMENT=production
# Logical environment name used in secret path construction.

# PAPERCLIP_SECRETS_AWS_DEPLOYMENT_ID=
# Deployment identifier used in secret path construction.

# PAPERCLIP_SECRETS_AWS_KMS_KEY_ID=
# KMS key ID/ARN used to encrypt secrets.

# PAPERCLIP_SECRETS_AWS_PREFIX=paperclip/
# Prefix for all secret names in AWS Secrets Manager.

# PAPERCLIP_SECRETS_AWS_ENDPOINT=
# Custom endpoint URL (for LocalStack or other compatible services).

# PAPERCLIP_SECRETS_AWS_DELETE_RECOVERY_DAYS=7
# Recovery window (days) when deleting secrets from AWS.


# -----------------------------------------------------------------------------
# Storage provider
# -----------------------------------------------------------------------------

# PAPERCLIP_STORAGE_PROVIDER=local_disk
# Storage backend. Values: local_disk | s3.

# PAPERCLIP_STORAGE_LOCAL_DIR=~/.paperclip/storage
# Directory for local disk storage. Required when provider=local_disk.


# -----------------------------------------------------------------------------
# Storage provider — S3 (or S3-compatible)
# Only required when PAPERCLIP_STORAGE_PROVIDER=s3
# -----------------------------------------------------------------------------

# PAPERCLIP_STORAGE_S3_BUCKET=paperclip
# S3 bucket name.

# PAPERCLIP_STORAGE_S3_REGION=us-east-1
# AWS region for S3 operations.

# PAPERCLIP_STORAGE_S3_ENDPOINT=
# Custom endpoint URL (for MinIO, R2, or other S3-compatible services).

# PAPERCLIP_STORAGE_S3_PREFIX=
# Key prefix for all objects stored in the bucket.

# PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=false
# Use path-style URLs instead of virtual-hosted-style (required for some S3-compatible services).


# -----------------------------------------------------------------------------
# AWS credentials (shared by S3, Secrets Manager, Bedrock, etc.)
# Standard AWS SDK env vars — set these or use IAM role / ~/.aws/credentials
# -----------------------------------------------------------------------------

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# AI / LLM providers
# -----------------------------------------------------------------------------

# ANTHROPIC_API_KEY=
# Anthropic API key. Required when using the Claude adapter.

# ANTHROPIC_BEDROCK_BASE_URL=
# Override base URL for Anthropic on Amazon Bedrock.

# CLAUDE_CODE_USE_BEDROCK=false
# Route Claude Code requests through Amazon Bedrock.

# OPENAI_API_KEY=
# OpenAI API key (used by certain adapters/tests).


# -----------------------------------------------------------------------------
# Database backups
# -----------------------------------------------------------------------------

# PAPERCLIP_DB_BACKUP_ENABLED=false
# Enable automatic database backups.

# PAPERCLIP_DB_BACKUP_INTERVAL_MINUTES=1440
# Backup interval in minutes. Default: 1440 (daily).

# PAPERCLIP_DB_BACKUP_RETENTION_DAYS=7
# Number of days to retain backup files.

# PAPERCLIP_DB_BACKUP_DIR=~/.paperclip/backups
# Directory to write backup files.


# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------

# PAPERCLIP_TELEMETRY_BACKEND_URL=
# URL of the telemetry collection endpoint.

# PAPERCLIP_TELEMETRY_BACKEND_TOKEN=
# Auth token for the telemetry endpoint.

# PAPERCLIP_TELEMETRY_DISABLED=false
# Set to true to disable all telemetry reporting.


# -----------------------------------------------------------------------------
# Feedback export
# -----------------------------------------------------------------------------

# PAPERCLIP_FEEDBACK_EXPORT_BACKEND_URL=
# URL of the feedback export backend.

# PAPERCLIP_FEEDBACK_EXPORT_BACKEND_TOKEN=
# Auth token for the feedback export backend.


# -----------------------------------------------------------------------------
# SSH live environment adapter
# Only required when using the live SSH environment driver
# -----------------------------------------------------------------------------

# PAPERCLIP_ENV_LIVE_SSH_HOST=
# SSH server hostname.

# PAPERCLIP_ENV_LIVE_SSH_PORT=22
# SSH server port.

# PAPERCLIP_ENV_LIVE_SSH_USERNAME=
# SSH login username.

# PAPERCLIP_ENV_LIVE_SSH_PRIVATE_KEY=
# PEM-encoded private key (inline). Use instead of PAPERCLIP_ENV_LIVE_SSH_PRIVATE_KEY_PATH.

# PAPERCLIP_ENV_LIVE_SSH_PRIVATE_KEY_PATH=
# Path to a PEM private key file.

# PAPERCLIP_ENV_LIVE_SSH_KNOWN_HOSTS=
# Known hosts entries (inline, one per line).

# PAPERCLIP_ENV_LIVE_SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
# Path to a known_hosts file.

# PAPERCLIP_ENV_LIVE_SSH_STRICT_HOST_KEY_CHECKING=true
# Enforce host key verification.

# PAPERCLIP_ENV_LIVE_SSH_REMOTE_WORKSPACE_PATH=/tmp/paperclip-workspaces
# Remote path where agent workspaces are created.

# PAPERCLIP_ENV_LIVE_SSH_NO_AUTO_FIXTURE=false
# Disable automatic fixture setup (test/dev only).


# -----------------------------------------------------------------------------
# File attachments
# -----------------------------------------------------------------------------

# PAPERCLIP_ALLOWED_ATTACHMENT_TYPES=image/png,image/jpeg,image/gif,image/webp
# Comma-separated MIME types allowed for issue attachments.

# PAPERCLIP_ATTACHMENT_MAX_BYTES=10485760
# Maximum attachment file size in bytes. Default: 10MB.


# -----------------------------------------------------------------------------
# Cloud / API bridge (cloud-connected instances only)
# -----------------------------------------------------------------------------

# PAPERCLIP_API_KEY=
# API key used to authenticate this instance with the Paperclip cloud.

# PAPERCLIP_API_URL=https://api.paperclip.ing
# Paperclip cloud API base URL.

# PAPERCLIP_RUNTIME_API_URL=
# Override for the runtime API URL (used by agents).

# PAPERCLIP_RUNTIME_API_CANDIDATES_JSON=
# JSON array of candidate runtime API URLs for load-balanced deployments.

# PAPERCLIP_CLOUD_TENANT_SERVER_TOKEN=
# Server-to-server token for cloud tenant communication.


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# PAPERCLIP_LOG_DIR=~/.paperclip/logs
# Directory for log files.


# -----------------------------------------------------------------------------
# Embedded Postgres (dev / embedded deployments)
# -----------------------------------------------------------------------------

# PAPERCLIP_EMBEDDED_POSTGRES_VERBOSE=false
# Enable verbose logging from the embedded Postgres process.


# -----------------------------------------------------------------------------
# OpenCode adapter
# -----------------------------------------------------------------------------

# PAPERCLIP_OPENCODE_COMMAND=opencode
# Command used to invoke the OpenCode CLI.

# PAPERCLIP_OPENCODE_STORAGE_DIR=~/.paperclip/opencode
# Storage directory for OpenCode adapter state.


# -----------------------------------------------------------------------------
# Worktree support (advanced / CI)
# -----------------------------------------------------------------------------

# PAPERCLIP_WORKTREES_DIR=~/.paperclip/worktrees
# Base directory for git worktrees created by agents.

# PAPERCLIP_WORKTREE_NAME=
# Name of the current worktree (set by the worktree harness).

# PAPERCLIP_IN_WORKTREE=false
# Set to true when running inside a worktree context.


# -----------------------------------------------------------------------------
# UI (Vite — prefix VITE_ to expose to the browser bundle)
# -----------------------------------------------------------------------------

# VITE_FEEDBACK_TERMS_URL=https://paperclip.ing/tos
# URL linked from the feedback/terms prompt in the UI.


# -----------------------------------------------------------------------------
# Discord integrations (scripts only)
# -----------------------------------------------------------------------------

# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
